<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Likhon.Light" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/theme_light_bg</item>
        <item name="android:statusBarColor">@color/theme_light_bg</item>
        <item name="android:navigationBarColor">@color/theme_light_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorPrimary">@color/theme_light_accent</item>
        <item name="android:colorAccent">@color/theme_light_accent</item>
        <item name="android:textColorPrimary">@color/theme_light_text</item>
        <item name="android:textColorSecondary">@color/theme_light_text_muted</item>
        <item name="android:colorControlActivated">@color/theme_light_accent</item>
    </style>

    <style name="Theme.Likhon.Dark" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/theme_dark_bg</item>
        <item name="android:statusBarColor">@color/theme_dark_bg</item>
        <item name="android:navigationBarColor">@color/theme_dark_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorPrimary">@color/theme_dark_accent</item>
        <item name="android:colorAccent">@color/theme_dark_accent</item>
        <item name="android:textColorPrimary">@color/theme_dark_text</item>
        <item name="android:textColorSecondary">@color/theme_dark_text_muted</item>
        <item name="android:colorControlActivated">@color/theme_dark_accent</item>
    </style>

</resources>
