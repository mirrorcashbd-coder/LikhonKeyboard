<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Voice typing only. Recognition itself is done by the phone's speech
         service, which owns the audio. Some of those services run inside the
         calling app, so the INTERNET permission is declared here for them;
         Likhon itself never sends anything to a server. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ hides other apps' services unless they are declared here,
         which made voice typing look available but never receive audio. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Likhon.Light">

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The liquid-glass showcase, opened from Settings → About. -->

        <!-- Invisible hop to the phone's speech screen; see VoiceScreenActivity. -->
        <activity
            android:name=".VoiceScreenActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Serves the bundled sticker art to the app that receives a sticker
             (InputConnection.commitContent or the clipboard). Read-only. -->
        <provider
            android:name=".StickerProvider"
            android:authorities="com.likhon.keyboard.stickers"
            android:exported="false"
            android:grantUriPermissions="true" />

        <service
            android:name=".LikhonIme"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>

</manifest>
